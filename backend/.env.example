# =============================================================================
# ASK Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/ask_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# --- JWT (min 64 characters, random alphanumeric) ---
JWT_SECRET=CHANGE_ME_use_a_long_random_string_minimum_64_characters_for_production_security

# --- AES Encryption (exactly 32 characters) ---
AES_SECRET_KEY=CHANGE_ME_exactly_32_characters!

# --- Mail (Gmail SMTP — use App Password, not your real password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# --- Super Admin (created on first startup if no admin exists) ---
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!

# --- CORS (comma-separated, for production deployment) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
